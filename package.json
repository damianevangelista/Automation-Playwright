{
  "name": "orangehr",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "clean:results": "node -e \"const fs = require('fs'); ['allure-results', 'allure-report', 'playwright-report', 'test-results'].forEach(f => fs.existsSync(f) && fs.rmSync(f, { recursive: true, force: true }))\"",
    "test": "npm run clean:results && playwright test --reporter=allure-playwright",
    "test:headed": "npm run clean:results && playwright test --headed --reporter=allure-playwright",
    "test:ui": "playwright test --ui --reporter=allure-playwright",
    "test:debug": "playwright test --debug --reporter=allure-playwright",
    "test:project": "playwright test --project --reporter=allure-playwright",
    "allure:generate": "allure generate allure-results --clean --single-file -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "report": "npm run allure:generate && npm run allure:open"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.7.0",
    "allure-playwright": "^3.8.0",
    "dotenv": "^17.4.2"
  }
}